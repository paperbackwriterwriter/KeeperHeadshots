# Claude — checks selfies and grades finished headshots
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# Gemini — renders the headshots from your selfies
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3-pro-image

# Required on Vercel (signs login cookies); generated automatically when running locally
# SESSION_SECRET=long-random-string

# Vercel Blob storage (added automatically when you connect a Blob store); without it, ./data is used
# BLOB_READ_WRITE_TOKEN=

# Optional
# PORT=3000
# DATA_DIR=./data
# GENERATION_CONCURRENCY=2

# Accounts with no limits (comma-separated), e.g. the site owner
# OWNER_EMAILS=you@example.com

# Stripe (payments). Live or test secret key.
# STRIPE_SECRET_KEY=sk_live_...
# Optional: webhook signing secret for /api/billing/webhook
# STRIPE_WEBHOOK_SECRET=whsec_...
