{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "fluid": true,
  "functions": {
    "server.js": {
      "maxDuration": 300,
      "includeFiles": "assets/og/**"
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/billing/webhook$).*)",
      "has": [
        {
          "type": "host",
          "value": "aiheadshot.guru"
        }
      ],
      "destination": "https://keeperheadshots.com/:path",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/v/:build/js/:path*",
      "destination": "/js/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://js.stripe.com\" \"https://checkout.stripe.com\" \"https://hooks.stripe.com\")"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/v/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "13 9 * * *"
    },
    {
      "path": "/api/cron/backup",
      "schedule": "43 3 * * *"
    }
  ]
}
