{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "express",
  "fluid": true,
  "functions": {
    "server.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/:path((?!api/billing/webhook$).*)",
      "has": [
        {
          "type": "host",
          "value": "aiheadshot.guru"
        }
      ],
      "destination": "https://keeperheadshots.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
